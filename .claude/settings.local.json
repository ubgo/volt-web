{
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(go run:*)",
      "Bash(pkl --version:*)",
      "Bash(pkl-gen-go:*)",
      "Bash(/Volumes/D/khanakia/go/bin/pkl-gen-go:*)",
      "Bash(go install:*)",
      "Bash(curl:*)",
      "Bash(chmod:*)",
      "Bash(sudo mv:*)",
      "Bash(/Volumes/D/khanakia/go/bin/pkl:*)",
      "Bash(PKL_EXEC=/Volumes/D/khanakia/go/bin/pkl /Volumes/D/khanakia/go/bin/pkl-gen-go:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod vendor:*)",
      "Bash(timeout 10 go run:*)",
      "Bash(go build:*)",
      "Bash(task --list:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(go get:*)",
      "Bash(go work vendor:*)",
      "Bash(go test:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" -H \"X-Emdash-Token: $EMDASH_HOOK_NONCE\" -H \"X-Emdash-Pty-Id: $EMDASH_PTY_ID\" -H \"X-Emdash-Event-Type: start\" -d @- \"http://127.0.0.1:$EMDASH_HOOK_PORT/hook\" || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" -H \"X-Emdash-Token: $EMDASH_HOOK_NONCE\" -H \"X-Emdash-Pty-Id: $EMDASH_PTY_ID\" -H \"X-Emdash-Event-Type: notification\" -d @- \"http://127.0.0.1:$EMDASH_HOOK_PORT/hook\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sf -X POST -H \"Content-Type: application/json\" -H \"X-Emdash-Token: $EMDASH_HOOK_NONCE\" -H \"X-Emdash-Pty-Id: $EMDASH_PTY_ID\" -H \"X-Emdash-Event-Type: stop\" -d @- \"http://127.0.0.1:$EMDASH_HOOK_PORT/hook\" || true"
          }
        ]
      }
    ]
  }
}
